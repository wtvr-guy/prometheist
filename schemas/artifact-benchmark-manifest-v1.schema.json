{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prometheist.local/schemas/artifact-benchmark-manifest-v1.schema.json",
  "title": "Prometheist Artifactized Benchmark Manifest v1",
  "type": "object",
  "required": ["dataset_version", "materializes_benchmark_version", "profile", "oracle", "events", "questions", "associations"],
  "properties": {
    "dataset_version": {"type": "string", "minLength": 1},
    "materializes_benchmark_version": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "profile": {"$ref": "#/$defs/ref"},
    "oracle": {"$ref": "#/$defs/ref"},
    "events": {"type": "array", "items": {"$ref": "#/$defs/ref"}},
    "questions": {"type": "array", "items": {"$ref": "#/$defs/ref"}},
    "associations": {"type": "array", "items": {"$ref": "#/$defs/ref"}}
  },
  "$defs": {
    "ref": {
      "type": "object",
      "required": ["path", "canonical_sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "canonical_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
