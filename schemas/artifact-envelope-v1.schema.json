{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prometheist.local/schemas/artifact-envelope-v1.schema.json",
  "title": "Prometheist Artifact Envelope v1",
  "type": "object",
  "required": ["artifact_id", "artifact_type", "schema_version", "source", "payload"],
  "properties": {
    "artifact_id": {"type": "string", "minLength": 1},
    "artifact_type": {"type": "string", "minLength": 1},
    "schema_version": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "source": {"type": "string", "minLength": 1},
    "conversation_id": {"type": "string", "minLength": 1},
    "correlation_id": {"type": "string", "minLength": 1},
    "causation_id": {"type": "string", "minLength": 1},
    "global_seq": {"type": "integer", "minimum": 1},
    "conversation_seq": {"type": "integer", "minimum": 1},
    "parent_artifact_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "payload": {"type": "object"},
    "blob_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sha256", "media_type", "size_bytes"],
        "properties": {
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "media_type": {"type": "string", "minLength": 1},
          "size_bytes": {"type": "integer", "minimum": 0},
          "logical_name": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
