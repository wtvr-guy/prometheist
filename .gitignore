.venv/
__pycache__/
*.pyc
.env
.pytest_cache/
# Only the latest verified sharing bundle belongs in the branch.
.tmp/*
!.tmp/latest-benchmark.zip
# Keep complete benchmark evidence locally. Share one verified run through the
# tracked .tmp/latest-benchmark.zip rather than committing thousands of files.
benchmarks/generated/
benchmarks/results/*.json
# The default .prometheist artifact journal is also deliberately visible in
# this development repository. Checked-in journals must contain test/synthetic
# evidence only; real deployments should configure an external artifact root.
